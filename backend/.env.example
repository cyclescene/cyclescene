# ============================================================================
# CycleScene Backend Environment Configuration
# ============================================================================
# This file contains all environment variables used across backend services:
# - api (main API gateway)
# - image-optimizer (image processing service)
# - scraperv2 (event scraper)
# - token-cleaner (utility for cleaning expired tokens)
# - admin-keys (CLI for managing admin API keys)
# - db-backups (database backup utility)
#
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
# Set to "dev" to enable .env file loading
# In production, this can be omitted or set to "production"
APP_ENV=dev

# Server Port Configuration
# The port the service will try to start on (default: 8080)
# If the specified port is in use, the service will automatically try up to 10 consecutive ports
# For example, if PORT=8080 is in use, it will try 8081, 8082, etc.
PORT=8080

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================

# Main Database - Turso/LibSQL (Required for all services)
# Get these values from your Turso dashboard: https://turso.tech/
TURSO_DB_URL=libsql://your-main-database-url.turso.io
TURSO_DB_RW_TOKEN=your-turso-rw-auth-token

# Monitoring Database - Turso/LibSQL (Required for API service only)
# Separate database for analytics and monitoring to isolate from main app data
TURSO_MONITORING_DB_URL=libsql://your-monitoring-database-url.turso.io
TURSO_MONITORING_DB_RW_TOKEN=your-monitoring-rw-auth-token

# Database Backup Configuration (Required for db-backups service)
# HTTP endpoint for database dumps
TURSO_DB_HTTP_URL=https://your-database-url.turso.io
# Uses TURSO_DB_RW_TOKEN from above for authentication

# ============================================================================
# GOOGLE CLOUD PLATFORM CONFIGURATION
# ============================================================================

# GCP Project Configuration (Required for storage and backups)
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-west1

# Cloud Storage Buckets
# Staging bucket for initial image uploads (API service)
STAGING_BUCKET_NAME=your-staging-bucket-name

# Alternative/legacy bucket name (if using older config)
GCS_BUCKET=your-gcs-bucket-name

# Service Account Email (Required for signed URLs)
SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com

# Database Backup Bucket (Required for db-backups service)
BACKUP_BUCKET=your-backup-bucket-name

# Eventarc Configuration (Optional - for image optimization events)
EVENTARC_CHANNEL_NAME=image-optimization-events

# ============================================================================
# EMAIL SERVICE CONFIGURATION (OPTIONAL)
# ============================================================================

# Resend API for sending emails
# Get your API key from: https://resend.com/
# NOTE: Magic link emails for ride/group editing won't work without this
RESEND_API_KEY=your-resend-api-key

# Edit Link Base URLs (Used in magic link emails)
EDIT_LINK_BASE_URL=https://form.cyclescene.cc/rides/edit
GROUP_EDIT_LINK_BASE_URL=https://form.cyclescene.cc/group/edit

# ============================================================================
# IMAGE OPTIMIZATION SERVICE
# ============================================================================

# URL for the image optimizer service
# For local development, use localhost
# In production, this would be the deployed service URL
IMAGE_OPTIMIZER_URL=http://localhost:8080

# Signed URL Duration (in minutes)
# How long upload URLs remain valid
SIGNED_URL_DURATION_MINUTES=15

# ============================================================================
# EXTERNAL ROUTE SERVICES (OPTIONAL - for scraperv2)
# ============================================================================

# Strava API Configuration
# Used to fetch route data from Strava
# Get access token from: https://www.strava.com/settings/api
STRAVA_ACCESS_TOKEN=your-strava-access-token

# RideWithGPS API Configuration
# Used to fetch route data from RideWithGPS
# Get credentials from: https://ridewithgps.com/api
RWGPS_AUTH_TOKEN=your-rwgps-auth-token
RWGPS_API_KEY=your-rwgps-api-key

# ============================================================================
# SCRAPER CONFIGURATION
# ============================================================================

# City code for event scraping
# Currently supports: pdx (Portland), slc (Salt Lake City)
CITY_CODE=pdx

# ============================================================================
# STRAVA INTEGRATION (OPTIONAL - for event import)
# ============================================================================

# Enable verbose debug logging for Strava OAuth and API operations
# Set to 'true' during development to see detailed logs
# MUST be 'false' or unset in production (to avoid logging sensitive data)
STRAVA_DEBUG=false

# OAuth credentials for Strava event import feature
# Get these from: https://www.strava.com/settings/api
# STRAVA_CLIENT_ID=your-strava-client-id
# STRAVA_CLIENT_SECRET=your-strava-client-secret

# OAuth callback path (default: /v1/strava/auth/callback)
# The full callback URL is constructed from the request host + this path
# NOTE: When registering in Strava, do NOT include trailing slash
# STRAVA_CALLBACK_PATH=/v1/strava/auth/callback

# ============================================================================
# DEVELOPMENT MODE (OPTIONAL)
# ============================================================================

# Set to 'true' to bypass BFF token authentication for local development
# WARNING: Never set this to true in production!
# This is primarily used by frontend services but can be referenced by backend
DEV_MODE=false
