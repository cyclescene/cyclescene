# Environment
# Set to "dev" for local development (enables .env file loading)
APP_ENV=dev

# Main Turso Database
# Primary database for ride events, groups, and user submissions
TURSO_DB_URL=libsql://your-main-database-url.turso.io
TURSO_DB_RW_TOKEN=your-turso-rw-auth-token

# Monitoring/Analytics Database
# Separate Turso instance for monitoring and analytics
TURSO_MONITORING_DB_URL=libsql://your-monitoring-database-url.turso.io
TURSO_MONITORING_DB_RW_TOKEN=your-monitoring-rw-auth-token

# Google Cloud Platform
# Required for image uploads and storage
GCP_PROJECT=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
