# Environment
# Set to "dev" for local development (enables .env file loading)
APP_ENV=dev

# Turso Database
# Main database for storing ride events and geocode cache
TURSO_DB_URL=libsql://your-database-url.turso.io
TURSO_DB_RW_TOKEN=your-turso-rw-auth-token

# City Configuration
# City code determines which city to scrape events for (e.g., "pdx", "slc")
# Defaults to "pdx" if not specified
CITY_CODE=pdx

# Route Fetching Services (Optional)
# These tokens enable automatic route fetching from Strava and RideWithGPS
# If not provided, route URLs will be stored but not fetched

# Strava API
# Required for fetching routes from Strava URLs
STRAVA_ACCESS_TOKEN=your-strava-access-token

# RideWithGPS API
# Required for fetching routes from RideWithGPS URLs
RWGPS_AUTH_TOKEN=your-rwgps-auth-token
RWGPS_API_KEY=your-rwgps-api-key

# Google Cloud Platform
# Note: Geocoding uses Application Default Credentials (ADC)
# When running on Cloud Run, the service account credentials are used automatically
# For local development, use: gcloud auth application-default login
