# City Configuration
# City code determines which city's data to display
# Options: "pdx" (Portland), "slc" (Salt Lake City), "la" (Los Angeles)
VITE_CITY_CODE=pdx

# API Configuration
# Base URL for the Cycle Scene API
VITE_API_BASE_URL=https://api.cyclescene.cc

# Form Application
# URL for the ride submission form
VITE_FORM_BASE_URL=https://form.cyclescene.cc

# Feature Flags
VITE_ENABLE_INSTALL_PROMPT_V2=false
VITE_ENABLE_RIDE_SEARCH=false

# Mapbox Configuration
# API token for map tiles and mapping functionality
# Get your token at: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your-mapbox-access-token
