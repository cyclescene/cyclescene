		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.18",
		"@tailwindcss/vite": "^4.1.13",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "^4.0.18",
		"bits-ui": "^2.15.5",
		"clsx": "^2.1.1",
		"jsdom": "^28.0.0",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
