# API Configuration
# Base URL for the Cycle Scene API
# Used for submitting new rides and groups
PUBLIC_API_URL=https://api.cyclescene.cc

# Development Mode
# Set to 'true' to bypass BFF token authentication for local development
# WARNING: Never set this to true in production!
# Note: Must use API_ prefix to be recognized as a private environment variable
API_DEV_MODE=false
