# API Configuration
# Base URL for the Cycle Scene API (PUBLIC - used in client-side API calls)
PUBLIC_API_URL=https://api.cyclescene.cc

# Base URL for server-side API calls (PRIVATE - used in form actions)
API_URL=https://api.cyclescene.cc

# Development Mode
# Set to 'true' to bypass BFF token authentication for local development
# WARNING: Never set this to true in production!
# Note: Must use API_ prefix to be recognized as a private environment variable
API_DEV_MODE=false

# Strava Integration
# Set to 'true' to enable Strava import button on the form page
PUBLIC_STRAVA_ENABLED=false

# Set to 'true' to enable verbose debug logging for Strava integration
# Useful for development and troubleshooting
PUBLIC_STRAVA_DEBUG=false
