# Main Turso Database
# Primary database for ride events, groups, and user submissions
TURSO_DATABASE_URL=libsql://your-main-database-url.turso.io
TURSO_AUTH_TOKEN=your-main-auth-token

# Marketing Analytics Database
# This is a separate Turso instance dedicated to tracking QR code sticker effectiveness
# and other marketing campaign metrics
ANALYTICS_DB_URL=libsql://your-analytics-database-url.turso.io
ANALYTICS_DB_TOKEN=your-analytics-auth-token
